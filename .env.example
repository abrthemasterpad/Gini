# Gini camera configuration
GINI_CAMERA_IP=172.14.10.1
GINI_CAMERA_PORT=10000
GINI_CAMERA_USER=admin
GINI_CAMERA_PASSWORD=

# Speech recognition
GINI_STT_LANGUAGE=en
GINI_SPEECH_THRESHOLD_DB=-36

# Hardware behavior
GINI_SPEAKER_MODE=camera
GINI_NATIVE_PTZ_MOVE_MS=1200

# AI assistant
# Offline-first default. Gini can continue working on camera Wi-Fi without internet.
GINI_AI_ENABLED=1
GINI_AI_PROVIDER=ollama
GINI_OLLAMA_URL=http://127.0.0.1:11434
GINI_OLLAMA_MODEL=qwen3:4b
GINI_AI_TIMEOUT_MS=35000

# Privacy / security
# Temporary AAC/WAV/transcript files are deleted after recognition when enabled.
GINI_PRIVACY_MODE=1

# Persistent memory is deliberately OFF by default.
# If enabled, only explicit "remember" / "forget" requests may write local memory.
GINI_MEMORY_ENABLED=0

# AI-generated physical actions are allowlisted and rate-limited.
GINI_ACTIONS_PER_MINUTE=6
GINI_MAX_REPLY_CHARS=320

# Never commit your real .env file.
# Do not expose the camera HTTP interface or port 10000 to the public internet.
