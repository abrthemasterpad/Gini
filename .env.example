# Gini camera configuration
GINI_CAMERA_IP=172.14.10.1
GINI_CAMERA_PORT=10000
GINI_CAMERA_USER=admin
GINI_CAMERA_PASSWORD=

# Speech recognition
GINI_STT_LANGUAGE=en
GINI_SPEECH_THRESHOLD_DB=-36

# Hardware behavior
GINI_SPEAKER_MODE=camera
GINI_NATIVE_PTZ_MOVE_MS=1200

# AI assistant
# Offline-first default. Gini can continue working on camera Wi-Fi without internet.
GINI_AI_ENABLED=1
GINI_AI_PROVIDER=ollama
GINI_OLLAMA_URL=http://127.0.0.1:11434
GINI_OLLAMA_MODEL=qwen3:0.6b
GINI_AI_TIMEOUT_MS=35000

# Privacy / security
# Temporary AAC/WAV/transcript files are deleted after recognition when enabled.
GINI_PRIVACY_MODE=1

# Persistent memory is deliberately OFF by default.
# If enabled, only explicit "remember" / "forget" requests may write local memory.
GINI_MEMORY_ENABLED=0

# AI-generated physical actions are allowlisted and rate-limited.
GINI_ACTIONS_PER_MINUTE=6
GINI_MAX_REPLY_CHARS=320

# Never commit your real .env file.
# Do not expose the camera HTTP interface or port 10000 to the public internet.


# Vision v0.5 (experimental)
# go2rtc local RTSP bridge; tracking is dry-run unless --live is explicitly used.
GINI_VISION_SOURCE=rtsp://127.0.0.1:8554/gini
GINI_VISION_WIDTH=640
GINI_VISION_HEIGHT=360
GINI_VISION_FPS=4
GINI_VISION_MIRROR_X=1
GINI_VISION_PTZ_INVERT_X=1
GINI_VISION_PTZ_INVERT_Y=0
GINI_VISION_PTZ_SPEED=1
GINI_VISION_TARGET_X=0.50
GINI_VISION_TARGET_Y=0.55
GINI_VISION_DEADZONE_X=0.13
GINI_VISION_DEADZONE_Y=0.16
GINI_VISION_STABLE_FRAMES=3
GINI_VISION_COOLDOWN_MS=1200
GINI_VISION_PULSE_MS=100
GINI_VISION_POST_MOVE_SETTLE_MS=900
GINI_VISION_MAX_LIVE_MOVES=8
GINI_VISION_LIVE_SECONDS=60


# Gini Teacher v0.1
# Reuses the local Rebuildo Voice Artist server. Keep it localhost-only.
GINI_REBUILDO_URL=http://127.0.0.1:8787
GINI_REBUILDO_TOKEN=
GINI_TEACHER_TAMIL_VOICE=female
GINI_TEACHER_TAMIL_DELIVERY=natural
GINI_TEACHER_TARGET_DELIVERY=clear
